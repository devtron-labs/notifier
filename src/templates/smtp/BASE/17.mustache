{
    "from": "{{fromEmail}}",
    "to": "{{toEmail}}",
    "subject": "Audit: {{module}} / {{action}} on {{resource}}",
    "html": "<div style=\"font-family:Arial,Helvetica,sans-serif;max-width:600px;margin:20px auto;border:1px solid #d0d4d9;border-radius:8px;padding:20px\"><h2 style=\"margin-top:0\">Audit Log Notification</h2><table cellpadding=6><tr><td style=\"color:#3b444c\">Module</td><td>{{module}}</td></tr><tr><td style=\"color:#3b444c\">Action</td><td>{{action}}</td></tr><tr><td style=\"color:#3b444c\">Resource</td><td>{{resource}}</td></tr><tr><td style=\"color:#3b444c\">Resource Name</td><td>{{resourceName}}</td></tr><tr><td style=\"color:#3b444c\">Performed by</td><td>{{updatedBy}}</td></tr><tr><td style=\"color:#3b444c\">Role</td><td>{{role}}</td></tr><tr><td style=\"color:#3b444c\">Time</td><td>{{eventTime}}</td></tr><tr><td style=\"color:#3b444c\">Client IP</td><td>{{clientIp}}</td></tr></table></div>"
}
